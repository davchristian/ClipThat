# demo works without any account. Switch to live after completing setup.
NEXT_PUBLIC_APP_MODE=demo
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy fallback; new projects should use SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional separate speech model. Empty uses GEMINI_MODEL.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Microphone: deepgram = streaming; gemini/whisper = 15-second audio chunks.
TRANSCRIPTION_PROVIDER=gemini
DEEPGRAM_API_KEY=
CAPTURE_SIGNING_SECRET=
JOB_RUNNER_SECRET=
# Calendar export uses .ics files; no calendar OAuth credentials are required.
# Optional Google Sign-In is configured separately in Supabase's Google provider.
# Optional: only needed when TRANSCRIPTION_PROVIDER=whisper.
OPENAI_API_KEY=


