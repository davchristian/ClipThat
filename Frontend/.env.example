# demo works without any account. Switch to live after completing setup.
NEXT_PUBLIC_APP_MODE=demo
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix these keys with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional legacy fallback; new projects should use SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CAPTURE_SIGNING_SECRET=
JOB_RUNNER_SECRET=
# Generate a separate 32-byte hexadecimal key for encrypted OAuth credentials.
INTEGRATION_ENCRYPTION_KEY=
# Outlook calendar. Redirect: APP_URL/api/integrations/outlook/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
# Separate from Google Sign-In, which is configured in Supabase's Google provider.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Public Notion OAuth integration. Redirect: APP_URL/api/integrations/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Optional: leave empty to disable microphone transcription.
OPENAI_API_KEY=
